<Project>
    <Target Name="GenerateMelonBuildInfo"
            BeforeTargets="BeforeCompile;CoreCompile"
            Inputs="$(MSBuildAllProjects)"
            Outputs="$(IntermediateOutputPath)MelonBuildInfo.g.cs">
        <PropertyGroup>
            <GeneratedText><![CDATA[
namespace $(RootNamespace)%3B

internal static class MelonBuildInfo
{
    public const string Name = "$(PackageId)"%3B
    public const string Description = "$(Description)"%3B
    public const string Author = "$(Authors)"%3B
    public const string Copyright = "$(Copyright)"%3B
    public const string ModVersion = "$(Version)"%3B
}
]]></GeneratedText>
            <GeneratedFilePath>$(IntermediateOutputPath)MelonBuildInfo.g.cs</GeneratedFilePath>
        </PropertyGroup>

        <ItemGroup>
            <Compile Include="$(GeneratedFilePath)"/>
            <FileWrites Include="$(GeneratedFilePath)"/>
        </ItemGroup>

        <WriteLinesToFile Lines="$(GeneratedText)"
                          File="$(GeneratedFilePath)"
                          WriteOnlyWhenDifferent="true"
                          Overwrite="true"/>
    </Target>
</Project>
